{
  "name": "@agentmetal/mcp",
  "version": "0.3.3",
  "description": "MCP server for AgentMetal \u2014 an AI agent can discover, pay (USDC via x402 or card), provision, SSH into, and run commands on its own Linux VPSes over HTTP 402. No signup.",
  "license": "MIT",
  "type": "module",
  "mcpName": "dev.agentmetal/agentmetal",
  "bin": {
    "agentmetal-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "model-context-protocol",
    "mcp-server",
    "ai",
    "llm",
    "agent",
    "x402",
    "vps",
    "usdc",
    "ssh",
    "exec",
    "cloud-server",
    "agentmetal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentmetal/mcp.git"
  },
  "homepage": "https://agentmetal.dev",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:watch": "node --test --watch test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@x402/evm": "^2.26.0",
    "@x402/fetch": "^2.26.0",
    "viem": "^2.56.8",
    "zod": "^4.6.5"
  }
}
